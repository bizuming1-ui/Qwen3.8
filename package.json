{
  "name": "qwen-kaggle-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A persistent, Git-backed Kaggle-style workbench for voice-cloning experiments.",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "qtts:setup": "bash scripts/setup_qtts.sh",
    "qtts": "bash scripts/start_qtts.sh",
    "qtts:unit": "PYTHONPATH=qtts/py .venv/bin/python -m unittest discover -s qtts/py -p 'test_arena_*.py' -v && node --check qtts/web/app.js && node --check qtts/web/recorder.js && node --check qtts/web/diagnostic-trace.js",
    "qtts:smoke": ".venv/bin/python qtts/tools/arena_smoke.py",
    "qtts:test": "npm run qtts:unit && npm run qtts:smoke"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@uiw/react-codemirror": "^4.23.13",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
